#!/bin/bash
# Install deps, then symlink singleton peer deps (react, ink, @inkjs/ui) from a
# sibling consumer repo. This prevents the dual-React crash when consumers
# `bun link` wrap-core — without this, wrap-core's own node_modules/react is a
# separate instance from the consumer's, and React hooks break.
#
# Works from worktrees: resolves the main repo root via git, then finds sibling
# repos relative to that.

set -euo pipefail

bun install "$@"

# Find the main worktree root (works from any worktree or the main repo)
MAIN_DIR=$(git worktree list --porcelain | head -1 | sed 's/worktree //')
PARENT=$(dirname "$MAIN_DIR")

# Pick the first consumer that has react installed
CONSUMER=""
for candidate in "$PARENT/wrap" "$PARENT/sweep"; do
  if [ -d "$candidate/node_modules/react" ]; then
    CONSUMER="$candidate"
    break
  fi
done

if [ -z "$CONSUMER" ]; then
  echo "setup: no sibling consumer with react found — skipping singleton symlinks"
  exit 0
fi

SINGLETONS=(react react-reconciler scheduler ink @inkjs/ui)

for pkg in "${SINGLETONS[@]}"; do
  SRC="$CONSUMER/node_modules/$pkg"
  DEST="node_modules/$pkg"
  if [ -d "$SRC" ]; then
    rm -rf "$DEST"
    ln -s "$SRC" "$DEST"
  fi
done

echo "setup: linked singletons from $(basename "$CONSUMER")"
